# ==============================================================================
# bybl Backend Environment Configuration Example
# Copy to .env and adjust as needed
# ==============================================================================

# Database Driver: 'postgres' (default in docker) or 'sqlite' (for zero-server local testing)
DB_DRIVER=postgres

# PostgreSQL Connection Settings (matches docker-compose service)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bybl_db

# PostgreSQL Docker Container Initialization
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bybl_db

# SQLite Path (only used if DB_DRIVER=sqlite or DB_HOST is empty)
SQLITE_PATH=Backend/theword.db

# Application HTTP Server
PORT=8080
ADMIN_PORT=8081
GIN_MODE=debug

# JWT Secret for Session & User Tokens
JWT_SECRET=bybl-jwt-super-secret-key-development-2026

# gofyrAdmin Drop-in Panel Settings
ADMIN_BASE_PATH=/admin
ADMIN_TITLE=bybl Admin
ADMIN_DEFAULT_DISK=local

# gofyrAdmin Default Superuser Credentials
# Default login enforces password reset & MFA setup on first login (no recovery codes pre-seeded)
ADMIN_EMAIL=admin@bybl.local
ADMIN_PASSWORD=admin123

# External Bible API Keys (Optional - mock passages available if empty)
BIBLE_KEY=
ESV_KEY=

# Email / Notifications Service (Optional)
RESEND_API_KEY=
EMAIL_ADDRESS=noreply@bybl.local

# Pluggable S3 / Wasabi Storage (Optional - defaults to local uploads if empty)
WASABI_REGION=us-east-1
WASABI_ENDPOINT=
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_BUCKET=
